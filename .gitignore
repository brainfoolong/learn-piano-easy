# looper:begin gitignore v2
# Scratch for every agent and tool, looper's run directory, and the data folder of the kit's copy.
/.agent-tmp/
/.loop/
/.looper/

# Build output and dependencies of each stack.
/target/
node_modules/

# Editors and OS.
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~
Thumbs.db
Desktop.ini
.DS_Store

# Claude Code's per-machine settings. The shared ones are .claude/settings.json.
.claude/settings.local.json
.claude/worktrees/
# looper:end gitignore

# The built app, written by `bun run build`.
/dist/

# Each machine's own environment, such as the dev server's HTTPS certificate in tools/dev.ts.
.env.local
